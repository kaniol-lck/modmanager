QWidget:focus {
  outline: none;
}

QWidget {
  color: black;
}

/* Disabled */
/*原来这里是 QWidget:disabled，会命中*所有*禁用控件（含 QLabel 等），
  把它们整块背景刷灰，既与其它规则打架也不是原意；收窄到真正需要灰底的输入类控件。*/
QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled,
QPushButton:disabled,
QToolButton:disabled,
QGroupBox:disabled {
  background-color: #cfcfcf;
}

/* DockWidget & Title */
.QWidget,
QDialog,
QLineEdit,
QSpinBox,
QDoubleSpinBox {
  background-color: #fafafa;
}

/* Browser */
Browser {
  background-color: #fafafa;
}

/* ModList inside */
Browser .ModList {
  background-color: #fafafa;
}

/* Tranparent */
Browser .QWidget,
Browser .QWidget .QScrollArea,
QDockWidget .QWidget,
QDockWidget .WebTextBrowser,
QDockWidget .QScrollArea,
QDockWidget .QLabel {
  background-color: transparent;
}

/* Label Texts */
.GitHubReleaseItemWidget,
.LocalModItemWidget {
  margin-left: 5px;
}

.DateTimeText>* {
  color: #777777;
  font-size: 9pt;
}

.Title {
  color: #000000;
  font-weight: bold;
  font-size: 13pt;
  background-color: transparent;
}

.CurseforgeFileListWidget .Title,
.ModrinthFileListWidget .Title,
.GitHubFileListWidget .Title,
.LocalFileListWidget .Title {
  font-size: 11pt;
}

.Description {
  color: #3f3f3f;
  font-size: 10pt;
  background: transparent;
}

.GitHubReleaseItemWidget>.PreRelease {
  color: #ffffff;
  background-color: #e7ab34;
  border-radius: 2px;
  padding: 1px 2px;
}

.GitHubReleaseItemWidget>.TagName {
  color: #777777;
  font-size: 10pt;
}

/* ModList */
/* 默认就保留左边框，否则 hover 时盒模型突变会让内容整体右移 5px */
.ModList::item {
  border-left: 5px solid transparent;
}

.ModList::item:hover {
  border-left: 5px solid #eeeeee;
  background-color: #22eeeeee;
}

.ModList::item:selected {
  border-left: 5px solid #37d;
  background-color: #223377dd;
  color: black;
}

/* TitleBar Button */
#maxButton,
#minButton,
#closeButton {
  border: none;
}

#maxButton:hover,
#minButton:hover {
  background-color: #dbdbdb;
  border: none;
}

#closeButton:hover {
  background-color: #e81123;
  border: none;
}

/* TitleBar Menu */
QMenuBar {
  color: #333333;
}

QMenuBar::item:selected {
  background-color: #dbdbdb;
}

QMenuBar::item:pressed {
  background-color: #d3d3d3;
  color: black;
}

/* Side Bar */
QTreeView.PageSelector::item {
  min-height: 40px;
}

QTreeView.PageSelector::item::selected {
  border: 1px solid #37d;
  border-radius: 3px;
  color: black;
}

QTreeView.PageSelector::item::hover {
  border: 1px solid #dbdbdb;
  border-radius: 3px;
  color: black;
}

/* Other Controls */
QToolBar {
  border: 1px solid #d3d3d3;
}

QGroupBox {
  background-color: whitesmoke;
  border: 1px solid #dbdbdb;
  border-radius: 5px;
  margin-top: 20px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top center;
  padding: 10px 15px;
}

QToolButton[autoRaise=false],
QToolBar:item,
QPushButton,
QComboBox {
  background-color: whitesmoke;
  border: 1px solid #d3d3d3;
  border-radius: 2px;
  padding: 4px;
  padding-right: 10px;
}

QToolButton[autoRaise=false]:hover,
QPushButton:hover,
QComboBox:hover {
  background-color: #cccccc;
  border: 1px solid #b4b4b4;
}

QToolButton[autoRaise=false]:pressed,
QPushButton:pressed,
QComboBox:pressed {
  background-color: #9e9e9e;
  border: 1px solid #dbdbdb;
}

QToolButton[autoRaise=false][popupMode="2"]::menu-indicator,
QPushButton::menu-indicator {
  subcontrol-origin: padding;
  subcontrol-position: center right;
}

QToolButton[autoRaise=true] {
  padding: 4px;
  padding-right: 9px;
}

QMenu,
QMenu:disabled,
QComboBox QAbstractItemView {
  font-size: 10pt;
  background-color: #fafafa;
  border-radius: 2px;
  border: 1px solid #979797;
  padding: 2px;
}

QMenu::item:selected {
  background: #737373;
  color: #ffffff;
}

QComboBox::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  border: none;
}

QToolButton[autoRaise=false][popupMode="2"]::menu-indicator,
QPushButton::menu-indicator,
QComboBox::down-arrow {
  image: url(:/icons/breeze-modmanager/16x16/go-down.svg);
}

QTreeView::item {
  min-height: 35px;
}

/* TabWidget */
/* 标签条是一条"贴合内容宽度"的浅色底槽（不是通铺整行），槽里放药丸式标签。
   原来的写法是 margin: 4px 10px：横向留 10px、纵向只有 4px，而 QTabBar 自身
   还有 2px margin，于是选中标签在底槽里上下只剩 2px 余量、左右却有 8~20px，
   看上去被"夹扁"；加上 11pt（比全局 10pt 还大）与 45px 的行高，整条显得又厚又挤。
   这里改成四边均衡留白，并去掉底槽那条基线。 */
.QTabWidget {
  border: none;
}

QTabWidget::pane {
  border: none;
}

QTabBar {
  background-color: #ededed;
  border: none;
  border-radius: 7px;
  margin: 0;
  padding: 0;
  qproperty-drawBase: 0; /* 去掉标签条底部那条横线 */
  /* 关键：不允许"挤压时改用滚动按钮"。
     Qt 默认允许，此时 QTabBar 的 minimumSizeHint 只有 145px（4 个标签实际要 360px），
     于是窗口可以被拖窄到 280px，标签放不下 → 两端插入两个 QToolButton 滚动按钮，
     直接压住最后一个标签，这才是"标签显得拥挤"最难看的一幕。
     关掉之后 minimumSizeHint = 360px，窗口最小宽度自动跟到 382px，标签永远完整可见。 */
  qproperty-usesScrollButtons: 0;
}

QTabBar::tab {
  /* 未选中也留同宽透明边框，选中时盒模型不突变、文字不会位移 */
  border: 1px solid transparent;
  border-radius: 5px;
  background-color: transparent;
  color: #5c5c5c;
  /*原来同时写死 min-width 与 max-width:75px，内容宽度被硬性卡住，
    "Description"/"Infomation" 这类较长的标签会被截断。
    现在只保留下限（短标签宽度一致），长标签按内容自然撑开。*/
  font-size: 10pt;
  min-width: 44px;
  padding: 5px 16px;
  margin: 4px 6px;
}

QTabBar::tab:hover:!selected {
  background-color: #e0e0e0;
  color: #1a1a1a;
}

QTabBar::tab:selected {
  border: 1px solid #d9d9d9;
  background-color: #ffffff;
  color: #1a1a1a;
}

/* 已禁用的 mod 条目（动态属性由 LocalModItemWidget 设置）。
   放在文件末尾是为了让它压过 .Title / .Description 等同优先级的类选择器。 */
QLabel[modDisabled="true"] {
  color: #777777;
}

/* ---- 以下控件原来没有任何样式，会回落到 Qt 原生外观，与整体风格割裂 ---- */

/* ScrollBar */
QScrollBar:vertical {
  background: transparent;
  width: 12px;
  margin: 0;
}

QScrollBar:horizontal {
  background: transparent;
  height: 12px;
  margin: 0;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
  background-color: #c8c8c8;
  border-radius: 6px;
}

QScrollBar::handle:vertical {
  min-height: 32px;
}

QScrollBar::handle:horizontal {
  min-width: 32px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
  background-color: #a8a8a8;
}

QScrollBar::add-line,
QScrollBar::sub-line {
  width: 0;
  height: 0;
  border: none;
  background: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
  background: none;
}

/* ProgressBar */
QProgressBar {
  background-color: #fafafa;
  border: 1px solid #d3d3d3;
  border-radius: 2px;
  text-align: center;
  color: black;
}

QProgressBar::chunk {
  background-color: #3377dd;
  border-radius: 1px;
}

/* CheckBox & RadioButton */
QCheckBox::indicator,
QRadioButton::indicator {
  width: 15px;
  height: 15px;
}

QCheckBox::indicator {
  background-color: #ffffff;
  border: 1px solid #b4b4b4;
  border-radius: 2px;
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
  background-color: #e4e4e4;
  border: 1px solid #c8c8c8;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
  border: 1px solid #8a8a8a;
}

QCheckBox::indicator:checked {
  background-color: #3377dd;
  border: 1px solid #3377dd;
  image: url(:/icons/breeze-modmanager/16x16/checkmark.svg);
}

QRadioButton::indicator {
  background-color: #ffffff;
  border: 1px solid #b4b4b4;
  border-radius: 8px;
}

QRadioButton::indicator:checked {
  border: 1px solid #3377dd;
  background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
                              stop:0 #3377dd, stop:0.4 #3377dd,
                              stop:0.45 #ffffff, stop:1 #ffffff);
}

/* HeaderView */
QHeaderView::section {
  background-color: #ececec;
  color: #333333;
  border: none;
  border-right: 1px solid #d3d3d3;
  border-bottom: 1px solid #d3d3d3;
  padding: 4px 6px;
}

/* ToolTip */
QToolTip {
  background-color: #fafafa;
  color: black;
  border: 1px solid #979797;
  padding: 2px 4px;
}

/* StatusBar */
QStatusBar {
  background-color: #fafafa;
  color: #333333;
}

QStatusBar::item {
  border: none;
}

/* Splitter */
QSplitter::handle {
  background-color: #fafafa;
}

QSplitter::handle:horizontal {
  width: 3px;
}

QSplitter::handle:vertical {
  height: 3px;
}

QSplitter::handle:hover {
  background-color: #dbdbdb;
}